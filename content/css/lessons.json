[
  {
    "key": "basics",
    "name": "How CSS works",
    "blurb": "Rules, selectors and the cascade",
    "cards": [
      {
        "title": "A rule = selector + declarations",
        "body": "Every CSS rule picks elements with a selector, then sets `property: value` pairs inside braces. Tap a value below and watch the text change.",
        "demo": {
          "base": "display:grid;place-items:center;",
          "kids": [
            {
              "s": "margin:0;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;",
              "t": "Hello, CSS"
            }
          ],
          "knobs": [
            {
              "prop": "color",
              "opts": [
                "black",
                "indigo",
                "tomato",
                "seagreen"
              ],
              "target": 0,
              "sel": "p",
              "start": 1
            },
            {
              "prop": "font-size",
              "opts": [
                "16px",
                "24px",
                "32px"
              ],
              "target": 0,
              "sel": "p",
              "start": 1
            }
          ]
        },
        "tip": "Each declaration ends with a `;`. Forget one and the browser quietly throws away the next declaration too."
      },
      {
        "title": "Selectors choose who gets styled",
        "body": "`p` matches every paragraph. `.note` matches anything with `class=\"note\"`. `#intro` matches the one element with `id=\"intro\"`.",
        "demo": {
          "kind": "choice",
          "label": "selector",
          "start": 0,
          "base": "display:flex;flex-direction:column;gap:8px;",
          "opts": [
            {
              "label": "p",
              "code": [
                "p { background: gold; }"
              ],
              "kids": [
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:gold;color:#1D1B26;",
                  "t": "<p id=\"intro\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:gold;color:#1D1B26;",
                  "t": "<p class=\"note\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:gold;color:#1D1B26;",
                  "t": "<p>"
                }
              ],
              "note": "Matches all 3 paragraphs"
            },
            {
              "label": ".note",
              "code": [
                ".note { background: gold; }"
              ],
              "kids": [
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p id=\"intro\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:gold;color:#1D1B26;",
                  "t": "<p class=\"note\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p>"
                }
              ],
              "note": "Matches 1 element — the one with class=\"note\""
            },
            {
              "label": "#intro",
              "code": [
                "#intro { background: gold; }"
              ],
              "kids": [
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:gold;color:#1D1B26;",
                  "t": "<p id=\"intro\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p class=\"note\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p>"
                }
              ],
              "note": "Matches 1 element — ids are unique"
            },
            {
              "label": "div",
              "code": [
                "div { background: gold; }"
              ],
              "kids": [
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p id=\"intro\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p class=\"note\">"
                },
                {
                  "s": "font-family:'JetBrains Mono',monospace;font-size:13px;padding:10px 12px;border-radius:8px;background:#F3F0E8;color:#1D1B26;",
                  "t": "<p>"
                }
              ],
              "note": "Matches nothing — and that’s not an error"
            }
          ]
        },
        "tip": "A selector can match many elements, one, or none. CSS never complains when nothing matches — it just does nothing."
      },
      {
        "title": "The cascade settles conflicts",
        "body": "When two rules set the same property on the same element, the more specific selector wins. If they tie, the rule written later wins. Change the second rule’s selector:",
        "demo": {
          "kind": "choice",
          "label": "second rule’s selector",
          "start": 0,
          "base": "display:grid;place-items:center;",
          "opts": [
            {
              "label": "p",
              "code": [
                "§<p id=\"intro\" class=\"lead\">",
                ".lead { color: tomato; }",
                "p { color: teal; }"
              ],
              "kids": [
                {
                  "s": "font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:34px;color:tomato",
                  "t": "Hello"
                }
              ],
              "note": ".lead (0·1·0) beats p (0·0·1) → tomato"
            },
            {
              "label": ".lead",
              "code": [
                "§<p id=\"intro\" class=\"lead\">",
                ".lead { color: tomato; }",
                ".lead { color: teal; }"
              ],
              "kids": [
                {
                  "s": "font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:34px;color:teal",
                  "t": "Hello"
                }
              ],
              "note": "A tie at 0·1·0 → the later rule wins → teal"
            },
            {
              "label": "#intro",
              "code": [
                "§<p id=\"intro\" class=\"lead\">",
                ".lead { color: tomato; }",
                "#intro { color: teal; }"
              ],
              "kids": [
                {
                  "s": "font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:34px;color:teal",
                  "t": "Hello"
                }
              ],
              "note": "#intro (1·0·0) beats .lead → teal"
            }
          ]
        },
        "tip": "Specificity first, then source order. Read the score as ID · class · tag and compare left to right."
      }
    ]
  },
  {
    "key": "box",
    "name": "The box model",
    "blurb": "Content, padding, border, margin",
    "cards": [
      {
        "title": "Every element is a box",
        "body": "Each box has four layers: content in the middle, then `padding`, then `border`, then `margin` on the outside. Grow each one and see where the space goes.",
        "demo": {
          "base": "display:grid;place-items:center;min-height:190px;",
          "kids": [
            {
              "w": "display:flex;background:#FCD9C8;border-radius:4px",
              "s": "background:linear-gradient(#FFFFFF,#FFFFFF) content-box,#C7CBFF;font-family:'JetBrains Mono',monospace;font-size:13px;",
              "t": "content"
            }
          ],
          "knobs": [
            {
              "prop": "padding",
              "opts": [
                "0",
                "12px",
                "24px"
              ],
              "target": 0,
              "sel": ".box",
              "start": 1
            },
            {
              "prop": "border",
              "opts": [
                "none",
                "4px solid",
                "8px solid"
              ],
              "target": 0,
              "sel": ".box",
              "start": 1
            },
            {
              "prop": "margin",
              "opts": [
                "0",
                "12px",
                "24px"
              ],
              "target": 0,
              "sel": ".box",
              "start": 1
            }
          ],
          "legend": [
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#FCD9C8",
              "l": "margin"
            },
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#1D1B26",
              "l": "border"
            },
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#C7CBFF",
              "l": "padding"
            },
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#FFFFFF",
              "l": "content"
            }
          ]
        },
        "tip": "Padding is inside the border and shows the background. Margin is outside, always transparent, and pushes neighbors away."
      },
      {
        "title": "box-sizing: what does width mean?",
        "body": "By default `width` sets only the content. Add padding and border and the box grows wider than you asked. `border-box` makes `width` include them.",
        "demo": {
          "base": "display:flex;flex-direction:column;align-items:center;gap:10px;",
          "kids": [
            {
              "s": "width:160px;height:22px;box-sizing:border-box;border:2px solid #5B5868;border-top:0;display:flex;justify-content:center;font-size:12px;font-weight:700;color:#5B5868;line-height:1;",
              "t": "160px"
            },
            {
              "s": "width:160px;background:#C7CBFF;border:4px solid #1D1B26;text-align:center;font-family:'JetBrains Mono',monospace;font-size:13px;",
              "t": "box"
            }
          ],
          "show": {
            ".box": [
              "width: 160px",
              "border: 4px solid"
            ]
          },
          "knobs": [
            {
              "prop": "box-sizing",
              "opts": [
                "content-box",
                "border-box"
              ],
              "target": 1,
              "sel": ".box",
              "start": 0
            },
            {
              "prop": "padding",
              "opts": [
                "0",
                "16px",
                "32px"
              ],
              "target": 1,
              "sel": ".box",
              "start": 2
            }
          ]
        },
        "tip": "Most projects start with `*, *::before, *::after { box-sizing: border-box; }` so sizes mean what they say."
      },
      {
        "title": "Shorthand: one to four values",
        "body": "One value sets all four sides. Two values mean vertical, then horizontal. Four values go clockwise: top, right, bottom, left.",
        "demo": {
          "base": "display:grid;place-items:center;min-height:170px;",
          "kids": [
            {
              "s": "background:linear-gradient(#FFFFFF,#FFFFFF) content-box,#C7CBFF;font-family:'JetBrains Mono',monospace;font-size:13px;border:2px solid #1D1B26;",
              "t": "content"
            }
          ],
          "show": {
            ".box": [
              "border: 2px solid"
            ]
          },
          "knobs": [
            {
              "prop": "padding",
              "opts": [
                "16px",
                "8px 32px",
                "0 32px 24px 0",
                "24px 8px 0"
              ],
              "target": 0,
              "sel": ".box",
              "start": 1
            }
          ],
          "legend": [
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#C7CBFF",
              "l": "padding"
            },
            {
              "sw": "width:14px;height:14px;border-radius:4px;border:1px solid #C9C3B6;background:#FFFFFF",
              "l": "content"
            }
          ]
        },
        "tip": "Clockwise from the top — think “TRouBLe”: Top, Right, Bottom, Left. Works for margin, padding and border-width."
      }
    ]
  },
  {
    "key": "flex",
    "name": "Flexbox basics",
    "blurb": "Line items up in a row or column",
    "cards": [
      {
        "title": "Turn on flex",
        "body": "Put `display: flex` on a parent and its children line up in a row. The parent is the flex container; its children are flex items.",
        "demo": {
          "base": "gap:8px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".row": [
              "gap: 8px"
            ]
          },
          "knobs": [
            {
              "prop": "display",
              "opts": [
                "block",
                "flex"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 0
            }
          ]
        },
        "tip": "Flexbox is one-dimensional: it arranges items along one line at a time. `gap` only works once the parent is flex or grid."
      },
      {
        "title": "Main axis: justify-content",
        "body": "`justify-content` shares out space along the main axis — left to right in a row.",
        "demo": {
          "base": "display:flex;gap:8px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".row": [
              "display: flex",
              "gap: 8px"
            ]
          },
          "knobs": [
            {
              "prop": "justify-content",
              "opts": [
                "flex-start",
                "center",
                "space-between",
                "space-around",
                "flex-end"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 2
            }
          ]
        },
        "tip": "The main axis is the direction items flow. In a row that’s horizontal."
      },
      {
        "title": "Cross axis: align-items",
        "body": "`align-items` positions items on the cross axis — top to bottom in a row. Items of different heights make it easy to see.",
        "demo": {
          "base": "display:flex;gap:8px;min-height:170px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;white-space:pre-line;",
              "t": "Two\nlines"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".row": [
              "display: flex"
            ]
          },
          "knobs": [
            {
              "prop": "align-items",
              "opts": [
                "stretch",
                "flex-start",
                "center",
                "flex-end"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 0
            }
          ]
        },
        "tip": "The default is `stretch`: items grow to fill the cross axis unless they have a fixed height."
      },
      {
        "title": "Direction swaps the axes",
        "body": "`flex-direction: column` turns the main axis vertical. Now `justify-content` moves items up and down instead of left and right.",
        "demo": {
          "base": "display:flex;gap:8px;height:200px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".row": [
              "display: flex"
            ]
          },
          "knobs": [
            {
              "prop": "flex-direction",
              "opts": [
                "row",
                "column"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 1
            },
            {
              "prop": "justify-content",
              "opts": [
                "flex-start",
                "center",
                "space-between"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 2
            }
          ]
        },
        "tip": "`justify-content` and `align-items` follow the axes, not the screen. Change direction and they change jobs."
      },
      {
        "title": "Share leftover space: flex-grow",
        "body": "`flex-grow` lets an item soak up spare room in the row. Items with 0 keep their natural size.",
        "demo": {
          "base": "display:flex;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".row": [
              "display: flex"
            ]
          },
          "knobs": [
            {
              "prop": "gap",
              "opts": [
                "0",
                "8px",
                "16px"
              ],
              "target": "parent",
              "sel": ".row",
              "start": 1
            },
            {
              "prop": "flex-grow",
              "opts": [
                "0",
                "1",
                "2"
              ],
              "target": 1,
              "sel": ".item:nth-child(2)",
              "start": 1
            }
          ]
        },
        "tip": "`flex: 1` is the everyday shorthand for “take the remaining space”."
      }
    ]
  },
  {
    "key": "grid",
    "name": "Grid basics",
    "blurb": "Rows and columns at once",
    "cards": [
      {
        "title": "Define columns",
        "body": "`display: grid` plus `grid-template-columns` draws columns. Items fill the cells left to right, then wrap onto the next row.",
        "demo": {
          "base": "display:grid;gap:8px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "4"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "5"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "6"
            }
          ],
          "show": {
            ".grid": [
              "display: grid",
              "gap: 8px"
            ]
          },
          "knobs": [
            {
              "prop": "grid-template-columns",
              "opts": [
                "1fr",
                "1fr 1fr",
                "1fr 1fr 1fr",
                "100px 1fr"
              ],
              "target": "parent",
              "sel": ".grid",
              "start": 2
            }
          ]
        },
        "tip": "Grid is two-dimensional: you shape rows and columns together. Flexbox is for a single row or column."
      },
      {
        "title": "The fr unit",
        "body": "`fr` means a fraction of the free space. `1fr 2fr` splits it one third and two thirds. `repeat(3, 1fr)` is shorthand for three equal columns.",
        "demo": {
          "base": "display:grid;gap:8px;",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "3"
            }
          ],
          "show": {
            ".grid": [
              "display: grid",
              "gap: 8px"
            ]
          },
          "knobs": [
            {
              "prop": "grid-template-columns",
              "opts": [
                "1fr 1fr",
                "1fr 2fr",
                "2fr 1fr",
                "repeat(3, 1fr)"
              ],
              "target": "parent",
              "sel": ".grid",
              "start": 1
            }
          ]
        },
        "tip": "`fr` shares what’s left after fixed sizes and gaps are taken, so `100px 1fr` means “100px, then the rest”."
      },
      {
        "title": "Spanning cells",
        "body": "An item can stretch across several columns with `grid-column: span 2`. The other items flow around it.",
        "demo": {
          "base": "display:grid;gap:8px;grid-template-columns:repeat(3,1fr);",
          "kids": [
            {
              "s": "background:#4338CA;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "1"
            },
            {
              "s": "background:#E4572E;color:#FFFFFF;font-weight:700;font-size:15px;border-radius:8px;padding:10px 14px;text-align:center;",
              "t": "2"
            },
            {
